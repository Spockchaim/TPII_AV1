    "fastify": "^4.28.1"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/node": "^22.5.4",
    "@vitest/coverage-v8": "^2.1.1",
    "prisma": "^5.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}