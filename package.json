{
  "name": "cinebridge-atv1",
  "version": "1.0.0",
  "description": "Microsserviço de recomendação e orquestração de equipes para a indústria audiovisual independente - CineBridge",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
